@model NewECO5.ViewModel.PowerMeterSettingViewModel




<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th style="width: 120px;"></th>
                <th style="width: 180px;">上限</th>
                <th style="width: 180px;">下限</th>
                <th style="width: 80px;"></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>電流</td>
                <td><input asp-for="Alarm_I_UpperLimit" class="form-control" /></td>
                <td><input asp-for="Alarm_I_LowerLimit" class="form-control" /></td>
                <td>A</td>
            </tr>
            <tr>
                <td>電壓</td>
                <td><input asp-for="Alarm_V_UpperLimit" class="form-control" /></td>
                <td><input asp-for="Alarm_V_LowerLimit" class="form-control" /></td>
                <td>V</td>
            </tr>
            <tr>
                <td></td>
                <td colspan="3">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Alarm_V_Type" value="0" />
                        <label class="form-check-label">線電壓</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Alarm_V_Type" value="1" />
                        <label class="form-check-label">相電壓</label>
                    </div>
                </td>
            </tr>
            <tr>
                <td>頻率</td>
                <td><input asp-for="Alarm_HzUpperLimit" class="form-control" /></td>
                <td><input asp-for="Alarm_HzLowerLimit" class="form-control" /></td>
                <td>Hz</td>
            </tr>
            <tr>
                <td>功率</td>
                <td><input asp-for="Alarm_kW_UpperLimit" class="form-control" /></td>
                <td><input asp-for="Alarm_kW_LowerLimit" class="form-control" /></td>
                <td>
                    kW <span class="ms-2">待機值</span>
                    <input asp-for="Alarm_kW_IdelValue" class="form-control d-inline-block ms-2" style="width: 120px;" />
                </td>
            </tr>
            <tr>
                <td>功因</td>
                <td><input asp-for="Alarm_PfUpperLimit" class="form-control" /></td>
                <td><input asp-for="Alarm_PfLowerLimit" class="form-control" /></td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>

<hr />

<h5 class="mt-4">用電未關告警</h5>
<div class="row mb-3">
    <label class="col-sm-2 col-form-label">功率上限</label>
    <div class="col-sm-3">
        <input asp-for="Alarm_notPowerOff_kW" class="form-control" />
    </div>
    <div class="col-auto">
        <span class="form-text">kW</span>
    </div>
</div>
<div class="row mb-3">
    <label class="col-sm-2 col-form-label">開始時間</label>
    <div class="col-sm-3">
        <input asp-for="Alarm_notPowerOffAlarmStartTime" class="form-control" type="datetime-local" />
    </div>
    <label class="col-sm-2 col-form-label text-end">結束時間</label>
    <div class="col-sm-3">
        <input asp-for="Alarm_notPowerOffAlarmEndTime" class="form-control" type="datetime-local" />
    </div>
</div>

<hr />

<h5 class="mt-4">超過用量告警</h5>
<div class="row mb-3">
    <label class="col-sm-2 col-form-label">電量上限</label>
    <div class="col-sm-3">
        <input asp-for="Alarm_KWh_UpperLimit" class="form-control" />
    </div>
    <div class="col-auto">
        <span class="form-text">kWh</span>
    </div>
</div>
