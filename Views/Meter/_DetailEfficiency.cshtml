@model NewECO5.ViewModel.MeterDetailViewModel

<div class="detail-section">
    <div class="mb-3">
        <label class="form-label">面積 (m²)</label>
        @Html.EditorFor(model => model.PowerMeterSetting.Area, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <div class="mb-3">
        <label class="form-label">人數</label>
        @Html.EditorFor(model => model.PowerMeterSetting.Persons, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <div class="mb-3">
        <label class="form-label">自訂名稱</label>
        @Html.EditorFor(model => model.PowerMeterSetting.CustomName, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <div class="mb-3">
        <label class="form-label">自訂數值</label>
        @Html.EditorFor(model => model.PowerMeterSetting.CustomValue, new { htmlAttributes = new { @class = "form-control" } })
    </div>
</div>
