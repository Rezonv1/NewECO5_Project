@{
    ViewData["Title"] = "測試電表連線";
}

<h2>測試電表通訊</h2>

<form asp-action="TestConnection" method="post" class="mt-4">
    <div class="form-group mb-3">
        <label for="ip">IP 位址</label>
        <input type="text" name="ip" class="form-control" placeholder="例如：192.168.1.35" required />
    </div>
    <div class="form-group mb-3">
        <label for="port">Port（預設 502）</label>
        <input type="number" name="port" class="form-control" value="502" required />
    </div>
    <div class="form-group mb-3">
        <label for="meterId">電表站號（Meter ID）</label>
        <input type="number" name="meterId" class="form-control" value="2" required min="1" max="255" />
    </div>
    <button type="submit" class="btn btn-primary">🔌 開始測試</button>
</form>

@if (ViewBag.Result != null)
{
    <div class="alert alert-info mt-4">
        <strong>結果：</strong> @ViewBag.Result
    </div>
}
