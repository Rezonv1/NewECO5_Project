@model NewECO5.ViewModel.MeterDetailViewModel
@{
    ViewData["Title"] = "Detail";
}

@section Styles {
    <link rel="stylesheet" href="~/css/detail.css" />
}
<form asp-action="ReadNow" method="post">
    <button type="submit" class="btn btn-success">立即讀取總用電</button>
</form>
<div class="container-fluid" id="pageWrapper">
    <div id="mainDetailArea">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>電表詳細資料</h2>
            <button id="toggleMeterList" class="btn btn-primary" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#meterListCanvas">
                顯示電表清單
            </button>
        </div>

        <ul class="nav nav-tabs" id="meterTabs" role="tablist">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#general" role="tab">一般</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#comm" role="tab">通訊</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#alarm" role="tab">警報</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#demand" role="tab">需量控制</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#efficiency" role="tab">效率</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#advanced" role="tab">進階</a></li>
        </ul>

        <div class="tab-content mt-3">
            <div class="tab-pane fade show active" id="general">@Html.Partial("_DetailGeneral", Model)</div>
            <div class="tab-pane fade" id="comm">@Html.Partial("_DetailComm", Model)</div>
            <div class="tab-pane fade" id="alarm">@Html.Partial("_DetailAlarm", Model.PowerMeterSetting)</div>
            <div class="tab-pane fade" id="demand">@Html.Partial("_DetailDemand", Model.PowerMeterSetting)</div>
            <div class="tab-pane fade" id="efficiency">@Html.Partial("_DetailEfficiency", Model)</div>
            <div class="tab-pane fade" id="advanced">@Html.Partial("_DetailAdvanced", Model.PowerMeterSetting)</div>
        </div>
    </div>

    <!-- Offcanvas 電表清單 -->
    <div class="offcanvas offcanvas-end w-50" tabindex="-1" id="meterListCanvas" data-bs-backdrop="false">

        <div class="offcanvas-header">
            <h5 class="offcanvas-title">電表清單</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="mb-3 d-flex">
                <select class="form-select me-2" id="searchField" style="width: 150px;">
                    <option value="SerialNr">流水號</option>
                    <option value="DeviceName">名稱</option>
                    <option value="Description">描述</option>
                </select>
                <input type="text" class="form-control" id="searchQuery" placeholder="輸入關鍵字" />
            </div>
            <div class="table-responsive">
                <table class="table table-striped" id="meterListTable">
                    <thead>
                        <tr>
                            <th>流水號</th>
                            <th>名稱</th>
                            <th>描述</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var meter in Model.MeterList)
                        {
                            <tr data-id="@meter.SerialNr">
                                <td>@meter.SerialNr</td>
                                <td>@meter.DeviceName</td>
                                <td>@meter.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/detail.js"></script>
}
