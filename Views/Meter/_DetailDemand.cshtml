@model NewECO5.ViewModel.PowerMeterSettingViewModel

<div class="container-fluid">
    <div class="row">
        <!-- 左側：契約容量 -->
        <div class="col-md-6">
            <h5 class="mb-3">契約容量</h5>

            <div class="mb-3">
                <label class="form-label">經常（尖峰）</label>
                <input asp-for="Dmd_Capacity" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">半尖峰（非夏月）</label>
                <input asp-for="Dmd_CapacityHalf" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">週六半尖峰</label>
                <input asp-for="Dmd_CapacitySatHalf" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">離峰</label>
                <input asp-for="Dmd_CapacityOff" class="form-control" />
            </div>
        </div>

        <!-- 右側：需量預測 -->
        <div class="col-md-6">
            <h5 class="mb-3">需量預測</h5>

            <div class="mb-3">
                <label class="form-label">需量預測模式</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Dmd_Mode" value="0" />
                    <label class="form-check-label">混合式</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Dmd_Mode" value="1" />
                    <label class="form-check-label">簡單線性回歸</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Dmd_Mode" value="2" />
                    <label class="form-check-label">多項式</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Dmd_Mode" value="3" />
                    <label class="form-check-label">雙指數平滑法</label>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">計算頻率（分鐘）</label>
                <input asp-for="Dmd_Interval" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">上限</label>
                <div class="input-group">
                    <input asp-for="Dmd_UpperLimit" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">下限</label>
                <div class="input-group">
                    <input asp-for="Dmd_LowerLimit" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
            </div>
        </div>
    </div>
</div>
