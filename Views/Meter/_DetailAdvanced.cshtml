@model NewECO5.ViewModel.PowerMeterSettingViewModel

<div class="detail-section">
    <div class="mb-3">
        <label asp-for="KVA_Diff" class="form-label">數值檢查誤差</label>
        <input asp-for="KVA_Diff" class="form-control" />
        <span asp-validation-for="KVA_Diff" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="KW_Check_limit" class="form-label">kW 檢查上限</label>
        <input asp-for="KW_Check_limit" class="form-control" />
        <span asp-validation-for="KW_Check_limit" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BufferToKeep" class="form-label">暫存天數</label>
        <input asp-for="BufferToKeep" class="form-control" />
        <span asp-validation-for="BufferToKeep" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="AutoReset" class="form-check-input" type="checkbox" />
        <label asp-for="AutoReset" class="form-check-label">自動歸零</label>
        <span asp-validation-for="AutoReset" class="text-danger"></span>
    </div>
</div>
