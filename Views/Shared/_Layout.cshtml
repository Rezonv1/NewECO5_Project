@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NewECO5</title>

    <!-- ✅ Bootstrap 样式 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/detail.css" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- ✅ 導覽列 -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">NewECO5</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">首頁</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="CommUnitSetting" asp-action="Index">通訊設定</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Meter" asp-action="Detail">電表詳細</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ✅ 主內容 -->
    <div class="container-fluid">
        @RenderBody()
    </div>

    <!-- ✅ 頁尾 -->
    <footer class="border-top mt-4 text-muted text-center">
        <div class="container py-3">
            &copy; @DateTime.Now.Year - NewECO5
        </div>
    </footer>

    <!-- ✅ Script：只留一組 bootstrap.bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="/js/detail.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
